              "index": 0,
              "type": "main"
            }
          ]
        ]
      }
    },
    {
      "parameters": {
        "mode": "expression",
        "expression": "={{ $('Extract Payload').item.json.eventType }}",
        "cases": [
          {
            "output": 0,
            "conditions": [
              {
                "value1": "={{ $('Extract Payload').item.json.eventType }}",
                "value2": "task.created",
                "operation": "equal"
              }
            ]
          },
          {
            "output": 1,
            "conditions": [
              {
                "value1": "={{ $('Extract Payload').item.json.eventType }}",
                "value2": "task.assigned",
                "operation": "equal"
              }
            ]
          },
          {
            "output": 2,
            "conditions": [
              {
                "value1": "={{ $('Extract Payload').item.json.eventType }}",
                "value2": "task.updated",
                "operation": "equal"
              },
              {
                "value1": "={{ $('Extract Payload').item.json.newStatus }}",
                "value2": "completed",
                "operation": "equal"
              }
            ]
          }
        ]
      },
